# Managed by the rios0rios0.runner_hardening runner_azure_devops role. Change
# the inventory, not this file.
#
# Read by azp-register, which sources it. No secret is ever stored here: a PAT
# reaches the box only for the length of a converge's registrations, in
# {{ _runner_azp_pat_file }}.
AZP_URL="{{ runner_azp_url }}"
AZP_POOL="{{ runner_azp_pool }}"
# An agent's PATH is the agents' own docker ({{ _runner_azp_bin_dir }}),
# its user's ~/.local/bin, then this.
AZP_SYSTEM_PATH="{{ _runner_azp_system_path }}"
# The name each instance registers with when it is new. An adopted agent keeps
# the one in its .agent.
{% for _n in runner_instances %}
AZP_AGENT_NAME_{{ _n }}="{{ _runner_azp_names[_n | string] }}"
{% endfor %}
