{#
  Sourced by every runtime script (lib.sh's load_host_env), so each value is a
  double-quoted shell assignment, escaped for that context. No secret belongs
  here: the file is world-readable on purpose, so the scripts can be static.
#}
{% macro q(value) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% endmacro %}
# {{ _runner_host_managed }}
RUNNER_FLAVOR={{ q(runner_flavor) }}
RUNNER_USER_PREFIX={{ q(runner_user_prefix) }}
RUNNER_BASE={{ q(runner_base_dir) }}
RUNNER_UNIT={{ q(runner_unit) }}
RUNNER_SLICE={{ q(runner_slice) }}
RUNNER_SBIN_PREFIX={{ q(runner_sbin_prefix) }}
RUNNER_CONFIG_DIR={{ q(runner_config_dir) }}
RUNNER_COUNT={{ q(runner_count_resolved) }}
RUNNER_TRUST={{ q(runner_trust) }}
RUNNER_WORKER_PATTERN={{ q(runner_worker_pattern) }}
RUNNER_WORK_POLICY={{ q(runner_work_policy) }}
RUNNER_TOOLCACHE_PREFIX={{ q(_runner_host_toolcache_prefix) }}
RUNNER_DISK_SOFT={{ q(runner_disk_soft_pct) }}
RUNNER_DISK_HARD={{ q(runner_disk_hard_pct) }}
RUNNER_STALE_DAYS={{ q(runner_stale_days) }}
RUNNER_DRAIN_TIMEOUT={{ q(runner_drain_timeout) }}
RUNNER_HEAVY_RUNNERS={{ q(runner_heavy_runners) }}
# Space-separated: all a home reset keeps of a runner's $HOME.
RUNNER_HOME_KEEP={{ q((_runner_host_home_keep_base + runner_home_keep_extra + (runner_home_seed | list)) | unique | join(' ')) }}
# Space-separated: the accounts de-privileged on this host, which verify and audit check.
RUNNER_OLD_USERS={{ q(runner_old_users | reject('equalto', 'none') | join(' ')) }}
