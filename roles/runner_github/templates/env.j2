# written by the rios0rios0.runner_hardening runner_github role; change the
# inventory and converge again, an edit here is overwritten. The keys, their
# order and their quoting are harden-gha-runners.sh's save_config, so the
# v0.1.0 installer still reads this file back as its own stored answers.
GHA_SCOPE="{{ runner_github_scope }}"
GHA_ORG="{{ runner_github_org }}"
GHA_REPO="{{ runner_github_repo if runner_github_scope == 'repo' else '' }}"
GHA_GROUP_ID="{{ runner_github_group_id | int }}"
GHA_LABELS="{{ runner_github_labels }}"
GHA_COUNT="{{ runner_count_resolved | int }}"
GHA_TRUST="{{ runner_trust }}"
GHA_OLD_USER="{{ runner_old_users | first if runner_old_users | length > 0 else 'none' }}"
GHA_HEAVY_RUNNERS="{{ runner_heavy_runners | int }}"
GHA_CODEQL_RAM="{{ runner_codeql_ram }}"
GHA_SLICE_CEILING="{{ runner_slice_ceiling }}"
WIPE_DOCKER_AFTER_JOB="{{ 'true' if runner_trust == 'untrusted' else 'false' }}"
SHARE_TOOLCACHE="{{ 'false' if runner_trust == 'untrusted' else 'true' }}"
RUNNER_NAME_PREFIX="{{ ansible_facts['hostname'] }}"
USER_PREFIX="{{ runner_user_prefix }}"
RUNNER_BASE="{{ runner_base_dir }}"
