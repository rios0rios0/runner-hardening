---
extends: 'default'
rules:
  line-length:
    max: 160
    # The Ansible test cases are tables: one row per case reads better than wrapped rows.
    ignore: |
      test/ansible/
  truthy:
    allowed-values: ['true', 'false']
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore: |
  build/
  .changes/
  inventory/local/
